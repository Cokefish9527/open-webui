# Ollama URL for the backend to connect
# The path '/ollama' will be redirected to the specified backend URL
OLLAMA_BASE_URL='http://localhost:11434'

OPENAI_API_BASE_URL=''
OPENAI_API_KEY=''

# TikTok Login Kit / Content Posting API
TIKTOK_CLIENT_KEY=sbawk3ib5xgpeo38k4
TIKTOK_CLIENT_SECRET=9lQ9WApJEGJ6UYcJiHSsaf0IPA5hqw5G
# Comma-separated
TIKTOK_SCOPES=user.info.basic,video.upload,video.publish

# AUTOMATIC1111_BASE_URL="http://localhost:7860"

# For production, you should only need one host as
# fastapi serves the svelte-kit built frontend and backend from the same host and port.
# To test with CORS locally, you can set something like
# CORS_ALLOW_ORIGIN='http://localhost:5173;http://localhost:8080'
CORS_ALLOW_ORIGIN='*'

# For production you should set this to match the proxy configuration (127.0.0.1)
FORWARDED_ALLOW_IPS='*'

# DO NOT TRACK
SCARF_NO_ANALYTICS=true
DO_NOT_TRACK=true
ANONYMIZED_TELEMETRY=false

####################################
# External Admin OAuth2 (Client Credentials)
####################################
EXTERNAL_ADMIN_CLIENT_ID=external-admin
EXTERNAL_ADMIN_CLIENT_SECRET=local-dev-client-secret
EXTERNAL_ADMIN_CLIENT_SECRET_ROLLOVER=
EXTERNAL_ADMIN_TOKEN_TTL_SECONDS=900
EXTERNAL_ADMIN_RATE_LIMIT_PER_MIN=60
# Leave blank to disable IP restrictions (comma separated list when enabled)
EXTERNAL_ADMIN_IP_WHITELIST=
# Space separated scopes returned with issued tokens
EXTERNAL_ADMIN_ALLOWED_SCOPES=customers:read customers:write
# Set to true to temporarily bypass all external admin auth checks (use with caution)
EXTERNAL_ADMIN_AUTH_BYPASS=true
# External Admin API Key (用于hsai_admin调用素材管理API)
EXTERNAL_ADMIN_API_KEY=hsai-admin-dev-key-20250103

####################################
# 存储配置 (Storage Configuration)
####################################

# STORAGE_PROVIDER: 存储提供者类型
# 可选值: "local" (本地存储), "s3" (S3兼容存储，如阿里云OSS), "gcs" (Google Cloud Storage), "azure" (Azure Blob Storage)
# 默认值: "local"
STORAGE_PROVIDER=local

# UPLOAD_DIR: 本地存储目录路径
# 当STORAGE_PROVIDER为"local"时使用此配置
# 默认值: "./uploads"
UPLOAD_DIR=./uploads

####################################
# 阿里云OSS (S3兼容) 配置
####################################

# S3_ACCESS_KEY_ID: 阿里云访问密钥ID
# 用于身份验证的访问密钥ID，可在阿里云控制台获取
S3_ACCESS_KEY_ID=

# S3_SECRET_ACCESS_KEY: 阿里云访问密钥
# 与访问密钥ID配对使用的密钥，用于身份验证
S3_SECRET_ACCESS_KEY=

# S3_REGION_NAME: 阿里云OSS区域名称
# 指定OSS存储桶所在的区域，如"oss-cn-hangzhou"
S3_REGION_NAME=

# S3_BUCKET_NAME: 阿里云OSS存储桶名称
# 指定要使用的OSS存储桶名称
S3_BUCKET_NAME=

# S3_ENDPOINT_URL: 阿里云OSS服务端点URL
# 指定OSS服务的访问端点，格式为"https://oss-{region}.aliyuncs.com"
S3_ENDPOINT_URL=

# S3_KEY_PREFIX: OSS对象键前缀
# 用于在存储桶中组织文件的前缀，类似于文件夹路径
S3_KEY_PREFIX=

# S3_USE_ACCELERATE_ENDPOINT: 是否使用传输加速端点
# 启用后可提高跨地域传输性能，但可能会产生额外费用
# 可选值: True/False
# 默认值: False
S3_USE_ACCELERATE_ENDPOINT=False

# S3_ADDRESSING_STYLE: S3寻址风格
# 可选值: "virtual" (虚拟寻址), "path" (路径寻址)
# 虚拟寻址是推荐方式，但某些旧版本客户端可能需要使用路径寻址
S3_ADDRESSING_STYLE=virtual

# S3_ENABLE_TAGGING: 是否启用对象标签
# 启用后可为上传的文件添加标签，便于管理和检索
# 可选值: True/False
# 默认值: False
S3_ENABLE_TAGGING=False

####################################
# Google Cloud Storage 配置
####################################

# GCS_BUCKET_NAME: Google Cloud Storage存储桶名称
GCS_BUCKET_NAME=

# GOOGLE_APPLICATION_CREDENTIALS_JSON: Google服务账户凭证JSON
GOOGLE_APPLICATION_CREDENTIALS_JSON=

####################################
# Azure Blob Storage 配置
####################################

# AZURE_STORAGE_ENDPOINT: Azure存储账户端点
AZURE_STORAGE_ENDPOINT=

# AZURE_STORAGE_CONTAINER_NAME: Azure存储容器名称
AZURE_STORAGE_CONTAINER_NAME=

# AZURE_STORAGE_KEY: Azure存储账户密钥
AZURE_STORAGE_KEY=

# 数据库配置
DATABASE_URL=postgresql://hsai:c5agLR%29ah28vnA3+%25Yyn@pgm-bp1x8d937cl58d1afo.pg.rds.aliyuncs.com:5432/Owen_ai
# n8n_workflow 数据库（默认启用，指向专用 Schema）
N8N_DATABASE_URL=postgresql://hsai:c5agLR%29ah28vnA3+%25Yyn@pgm-bp1x8d937cl58d1afo.pg.rds.aliyuncs.com:5432/n8n_workflow
N8N_DATABASE_SCHEMA=public
N8N_DATABASE_POOL_SIZE=5
N8N_DATABASE_POOL_MAX_OVERFLOW=10
N8N_DATABASE_POOL_TIMEOUT=30
N8N_DATABASE_POOL_RECYCLE=1800
# Owen Admin（任务模板/清单）数据库（与 Owen_ai 同实例）
ADMIN_DATABASE_URL=postgresql://hsai:c5agLR%29ah28vnA3+%25Yyn@pgm-bp1x8d937cl58d1afo.pg.rds.aliyuncs.com:5432/Owen_admin
ADMIN_DATABASE_SCHEMA=public
ADMIN_DATABASE_POOL_SIZE=5
ADMIN_DATABASE_POOL_MAX_OVERFLOW=10
ADMIN_DATABASE_POOL_TIMEOUT=30
ADMIN_DATABASE_POOL_RECYCLE=1800
# 运行时自检：可通过 ENV_REQUIRE_N8N=false 临时关闭
ENV_REQUIRE_N8N=true
# 允许自定义校验的关键表（逗号分隔）
N8N_REQUIRED_TABLES=hsai_business_api_usage_log,hsai_business_good_video_v1

####################################
# Redis配置 - 可切换内网/公网
####################################

# REDIS_MODE: Redis连接模式
# 可选值: "internal" (内网), "external" (公网)
# 默认值: "internal"
REDIS_MODE=external

# Redis queue/signal listener (default false; for multi-instance, enable only one)
ENABLE_REDIS_QUEUE_LISTENER=true

# 内网Redis配置
INTERNAL_REDIS_URL=redis://192.168.20.31:6379/0
INTERNAL_WEBSOCKET_REDIS_URL=redis://192.168.20.31:6379/0

# 公网Redis配置
EXTERNAL_REDIS_HOST=r-bp16h5hix81xr15svxpd.redis.rds.aliyuncs.com
EXTERNAL_REDIS_PORT=6379
EXTERNAL_REDIS_DB=7
EXTERNAL_REDIS_USERNAME=r-bp16h5hix81xr15svx
EXTERNAL_REDIS_PASSWORD=hdtFOXRwdFA1EZzaypqv7PE6j1XuVT
EXTERNAL_WEBSOCKET_REDIS_HOST=r-bp16h5hix81xr15svxpd.redis.rds.aliyuncs.com
EXTERNAL_WEBSOCKET_REDIS_PORT=6379
EXTERNAL_WEBSOCKET_REDIS_DB=7
EXTERNAL_WEBSOCKET_REDIS_USERNAME=r-bp16h5hix81xr15svx
EXTERNAL_WEBSOCKET_REDIS_PASSWORD=hdtFOXRwdFA1EZzaypqv7PE6j1XuVT

