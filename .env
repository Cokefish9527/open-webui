# When STORAGE_PROVIDER=local, UGC assets can be uploaded to OSS via ffmpeg-go `/oss/upload`.
# Requires: USE_FFMPEG_OSS=true and FFMPEG_API_BASE_URL configured.
UGC_ASSET_OSS_PATH_PREFIX=ugc/assets

# Asset URL generation (presigned URL expiry seconds, default 7200)
UGC_ASSET_URL_EXPIRES_SECONDS=7200

# PostgreSQL DDL timeouts for UGC runtime migrations (avoid request hanging on lock waits)
UGC_SCHEMA_LOCK_TIMEOUT_SECONDS=5
UGC_SCHEMA_STATEMENT_TIMEOUT_SECONDS=30

# Watchdog: scan status in {1,3,5} and mark stale as failed
UGC_WATCHDOG_ENABLED=true
UGC_WATCHDOG_INTERVAL_MINUTES=5
UGC_WATCHDOG_TIMEOUT_MINUTES=30
