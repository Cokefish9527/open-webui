# WebUI配置
WEBUI_AUTH=True
WEBUI_SECRET_KEY=t0p-s3cr3t
WEBUI_URL=https://owen-ai.hsai.cc/

# 其他配置
ENV=dev

FFMPEG_EXECUTABLE=ffmpeg
FFPROBE_EXECUTABLE=ffprobe

GLOBAL_LOG_LEVEL=DEBUG
# 或者只针对CONFIG模块
CONFIG_LOG_LEVEL=DEBUG

####################################
# Ops Dashboard Integration
####################################

# 是否开启后台统计接口上报
OPS_DASHBOARD_ENABLED=true
# 后台采集接口根路径（内网）
OPS_DASHBOARD_BASE_URL=http://192.168.20.32:5000
# 若后台需要API Key，请在此配置（留空则不携带）
OPS_DASHBOARD_API_KEY=
# HTTP请求超时时间（秒）
OPS_DASHBOARD_TIMEOUT=5
# 最大重试次数
OPS_DASHBOARD_MAX_RETRY=8
# 是否允许发送消息正文内容
OPS_DASHBOARD_ALLOW_CONTENT=false

####################################
# HSAI 素材缓存 / OSS 回填
####################################

# 是否启用素材 Redis 缓存（目录树 + 列表快照）
HSAI_MATERIALS_CACHE_ENABLED=true
# 缓存 TTL（秒）
HSAI_MATERIALS_CACHE_TTL_SEC=900
# 定时刷新间隔（秒）
HSAI_MATERIALS_CACHE_REFRESH_INTERVAL_SEC=300

# 是否启用缓存失效后的 OSS→DB 回填（依赖 ffmpeg-go /oss/* 可用）
HSAI_MATERIALS_OSS_SYNC_ENABLED=true
# 单次列举最大对象数（1-1000）
HSAI_MATERIALS_OSS_MAX_KEYS=1000
# 显式指定 OSS Bucket（素材管理专用bucket）
HSAI_MATERIALS_OSS_BUCKET=aima-hotvideogeneration-videolibrary

# ffmpeg-go OSS 中台（用于列举/下载签名/上传等）
USE_FFMPEG_OSS=true
FFMPEG_API_BASE_URL=http://192.168.20.32:8082
# 建议填写裸 token，服务端会自动补齐 Bearer；如已包含 Bearer 前缀也可直接填写完整值
FFMPEG_API_KEY=
FFMPEG_API_TIMEOUT=30

