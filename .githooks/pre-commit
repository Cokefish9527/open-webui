#!/usr/bin/env bash

set -euo pipefail

ROOT_DIR="$(git rev-parse --show-toplevel)"
PYTHON_BIN="${PYTHON:-python}"

# 获取待提交的Python文件列表
CHANGED_PY_FILES=$(git diff --cached --name-only --diff-filter=ACMR "*.py" || true)

# 只有当有待提交的Python文件时才执行检查
if [ -n "$CHANGED_PY_FILES" ]; then
    echo "[pre-commit] 检查 ${PYTHON_BIN} tool/clean_special_chars.py"
    
    # 将文件列表传递给脚本进行检查
    CHECK_FAILED=0
    echo "$CHANGED_PY_FILES" | while read -r file; do
        if [ -n "$file" ]; then
            # 检查文件是否存在且在磁盘上
            if [ -f "$file" ]; then
                if ! "${PYTHON_BIN}" "${ROOT_DIR}/tool/clean_special_chars.py" --check "$file"; then
                    CHECK_FAILED=1
                fi
            fi
        fi
    done
    
    if [ $CHECK_FAILED -eq 1 ]; then
        echo "[pre-commit] 字符检查失败，请修复上述问题后再提交"
        exit 1
    else
        echo "[pre-commit] 字符检查通过"
    fi
else
    echo "[pre-commit] 没有待提交的Python文件，跳过字符扫描"
fi