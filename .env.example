# Ollama URL for the backend to connect
# The path '/ollama' will be redirected to the specified backend URL
OLLAMA_BASE_URL='http://localhost:11434'

OPENAI_API_BASE_URL=''
OPENAI_API_KEY=''

# AUTOMATIC1111_BASE_URL="http://localhost:7860"

# For production, you should only need one host as
# fastapi serves the svelte-kit built frontend and backend from the same host and port.
# To test with CORS locally, you can set something like
# CORS_ALLOW_ORIGIN='http://localhost:5173;http://localhost:8080'
CORS_ALLOW_ORIGIN='*'

# For production you should set this to match the proxy configuration (127.0.0.1)
FORWARDED_ALLOW_IPS='*'

# DO NOT TRACK
SCARF_NO_ANALYTICS=true
DO_NOT_TRACK=true
ANONYMIZED_TELEMETRY=false

####################################
# Ops Dashboard Integration
####################################

OPS_DASHBOARD_ENABLED=false
# 例如：http://192.168.20.32:5000
OPS_DASHBOARD_BASE_URL=
OPS_DASHBOARD_API_KEY=
OPS_DASHBOARD_TIMEOUT=5
OPS_DASHBOARD_MAX_RETRY=8
OPS_DASHBOARD_ALLOW_CONTENT=false

####################################
# Database Connections
####################################
# Primary application数据库，默认使用 SQLite，可替换为 PostgreSQL 连接串
DATABASE_URL=
DATABASE_SCHEMA=public

# Owen Admin（任务模板 / 素材清单）数据源，默认复用主库；若使用独立库请填写
ADMIN_DATABASE_URL=
ADMIN_DATABASE_SCHEMA=public
ADMIN_DATABASE_POOL_SIZE=5
ADMIN_DATABASE_POOL_MAX_OVERFLOW=5
ADMIN_DATABASE_POOL_TIMEOUT=30
ADMIN_DATABASE_POOL_RECYCLE=3600

# n8n workflow 库（蓝图/脚本）
N8N_DATABASE_URL=
N8N_DATABASE_SCHEMA=public
N8N_DATABASE_POOL_SIZE=5
N8N_DATABASE_POOL_MAX_OVERFLOW=5
N8N_DATABASE_POOL_TIMEOUT=30
N8N_DATABASE_POOL_RECYCLE=3600

####################################
# External Admin OAuth2 (Client Credentials)
####################################
EXTERNAL_ADMIN_CLIENT_ID=external-admin
EXTERNAL_ADMIN_CLIENT_SECRET=
EXTERNAL_ADMIN_CLIENT_SECRET_ROLLOVER=
EXTERNAL_ADMIN_TOKEN_TTL_SECONDS=900
EXTERNAL_ADMIN_RATE_LIMIT_PER_MIN=60
# Leave blank to disable IP restrictions (comma separated list when enabled)
EXTERNAL_ADMIN_IP_WHITELIST=
# Space separated scopes returned with issued tokens (update per tenant)
EXTERNAL_ADMIN_ALLOWED_SCOPES=customers:read customers:write
# Set to true to temporarily bypass all external admin auth checks (use with caution)
EXTERNAL_ADMIN_AUTH_BYPASS=true

####################################
# 存储配置 (Storage Configuration)
####################################

# STORAGE_PROVIDER: 存储提供者类?
# 可选? "local" (本地存储), "s3" (S3兼容存储，如阿里云OSS), "gcs" (Google Cloud Storage), "azure" (Azure Blob Storage)
# 默认? "local"
STORAGE_PROVIDER=local
# زϴû˾һĿ¼ `<company>/<user>/<hash-name>`лΪ s3 Ŀ¼ṹΪ OSS ǰ׺

# UPLOAD_DIR: 本地存储目录路径
# 当STORAGE_PROVIDER?local"时使用此配置
# 默认? "./uploads"
UPLOAD_DIR=./uploads

####################################
# 阿里云OSS (S3兼容) 配置
####################################

# S3_ACCESS_KEY_ID: 阿里云访问密钥ID
# 用于身份验证的访问密钥ID，可在阿里云控制台获?
S3_ACCESS_KEY_ID=

# S3_SECRET_ACCESS_KEY: 阿里云访问密?
# 与访问密钥ID配对使用的密钥，用于身份验证
S3_SECRET_ACCESS_KEY=

# S3_REGION_NAME: 阿里云OSS区域名称
# 指定OSS存储桶所在的区域，如"oss-cn-hangzhou"
S3_REGION_NAME=

# S3_BUCKET_NAME: 阿里云OSS存储桶名?
# 指定要使用的OSS存储桶名?
S3_BUCKET_NAME=

# S3_ENDPOINT_URL: 阿里云OSS服务端点URL
# 指定OSS服务的访问端点，格式?https://oss-{region}.aliyuncs.com"
S3_ENDPOINT_URL=

# S3_KEY_PREFIX: OSS对象键前缀
# 用于在存储桶中组织文件的前缀，类似于文件夹路?
S3_KEY_PREFIX=

# S3_USE_ACCELERATE_ENDPOINT: 是否使用传输加速端?
# 启用后可提高跨地域传输性能，但可能会产生额外费?
# 可选? True/False
# 默认? False
S3_USE_ACCELERATE_ENDPOINT=False

# S3_ADDRESSING_STYLE: S3寻址风格
# 可选? "virtual" (虚拟寻址), "path" (路径寻址)
# 虚拟寻址是推荐方式，但某些旧版本客户端可能需要使用路径寻址
S3_ADDRESSING_STYLE=virtual

# S3_ENABLE_TAGGING: 是否启用对象标签
# 启用后可为上传的文件添加标签，便于管理和检?
# 可选? True/False
# 默认? False
S3_ENABLE_TAGGING=False

####################################
# Google Cloud Storage 配置
####################################

# GCS_BUCKET_NAME: Google Cloud Storage存储桶名?
GCS_BUCKET_NAME=

# GOOGLE_APPLICATION_CREDENTIALS_JSON: Google服务账户凭证JSON
GOOGLE_APPLICATION_CREDENTIALS_JSON=

####################################
# Azure Blob Storage 配置
####################################

# AZURE_STORAGE_ENDPOINT: Azure存储账户端点
AZURE_STORAGE_ENDPOINT=

# AZURE_STORAGE_CONTAINER_NAME: Azure存储容器名称
AZURE_STORAGE_CONTAINER_NAME=

# AZURE_STORAGE_KEY: Azure存储账户密钥
AZURE_STORAGE_KEY=
####################################
# PostgreSQL 同步脚本参数 (sqlite_to_postgres_sync.py)
####################################

# PostgreSQL 连接信息
POSTGRES_HOST=
POSTGRES_PORT=5432
POSTGRES_DB=
POSTGRES_USER=
POSTGRES_PASSWORD=
# POSTGRES_SSLMODE=require

