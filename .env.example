# Open WebUI 示例配置（复制为 .env 后按环境修改）

####################################
# 基础：后端连接与前端基址
####################################
# Ollama URL（后端连接用）
OLLAMA_BASE_URL='http://localhost:11434'
# 如果前后端分离开发（如前端 5173、后端 8080），可显式指定后端基址
VITE_WEBUI_BASE_URL='http://localhost:8080'

# OpenAI 兼容接口（可选）
OPENAI_API_BASE_URL=''
OPENAI_API_KEY=''

# AUTOMATIC1111（可选）
# AUTOMATIC1111_BASE_URL="http://localhost:7860"

####################################
# CORS / 反向代理
####################################
# 生产环境建议按代理配置设置（例如仅允许 127.0.0.1），避免误信任转发头
FORWARDED_ALLOW_IPS='*'

# 生产环境建议显式指定允许的 Origin（示例：'http://localhost:5173;http://localhost:8080'）
CORS_ALLOW_ORIGIN='*'

####################################
# 隐私/遥测
####################################
SCARF_NO_ANALYTICS=true
DO_NOT_TRACK=true
ANONYMIZED_TELEMETRY=false

####################################
# Ops Dashboard 集成
####################################
OPS_DASHBOARD_ENABLED=false
OPS_DASHBOARD_BASE_URL=
OPS_DASHBOARD_API_KEY=
OPS_DASHBOARD_TIMEOUT=5
OPS_DASHBOARD_MAX_RETRY=8
OPS_DASHBOARD_ALLOW_CONTENT=false

####################################
# 数据库连接（主库 / 管理库）
####################################
DATABASE_URL=
DATABASE_SCHEMA=public

# DB 连接超时（秒）：避免 DB 不可达时长时间阻塞
DATABASE_CONNECT_TIMEOUT=5

# SQLAlchemy 连接池（DATABASE_POOL_SIZE=0 表示禁用连接池/使用 NullPool）
DATABASE_POOL_SIZE=0
DATABASE_POOL_MAX_OVERFLOW=0
DATABASE_POOL_TIMEOUT=30
DATABASE_POOL_RECYCLE=3600

# Owen Admin / 后台管理库
ADMIN_DATABASE_URL=
ADMIN_DATABASE_SCHEMA=public
ADMIN_DATABASE_POOL_SIZE=5
ADMIN_DATABASE_POOL_MAX_OVERFLOW=5
ADMIN_DATABASE_POOL_TIMEOUT=30
ADMIN_DATABASE_POOL_RECYCLE=3600

####################################
# UGC 视频生成（V3.2）
####################################
# n8n Webhook base url（示例：https://webhook-n8n.example.com/webhook）
N8N_UGC_BASE_URL=

# 后端注入到 hs001-hs004 payload 的凭证（以当前联调实现为准）
JARVIS_API_KEY=
MINIMAX_KEY=
MINIMAX_GROUP=
RUNNINGHUB_API_KEY=
RUNNINGHUB_WORKFLOW_ID=

# 当 STORAGE_PROVIDER=local 时，UGC 资产可通过 ffmpeg-go `/oss/upload` 上传到 OSS
# 前提：USE_FFMPEG_OSS=true 且已配置 FFMPEG_API_BASE_URL
UGC_ASSET_OSS_PATH_PREFIX=ugc/assets

# 资产 URL 生成：presigned URL 有效期（秒，默认 7200）
UGC_ASSET_URL_EXPIRES_SECONDS=7200

# PostgreSQL DDL 超时（用于 UGC runtime migrations，避免锁等待导致请求挂起）
UGC_SCHEMA_LOCK_TIMEOUT_SECONDS=5
UGC_SCHEMA_STATEMENT_TIMEOUT_SECONDS=30

# Watchdog：扫描进行中的任务，超时后自动关闭（status=-2）
UGC_WATCHDOG_ENABLED=true
UGC_WATCHDOG_INTERVAL_MINUTES=5
# 默认超时阈值（分钟）
UGC_TASK_STALE_TIMEOUT_MINUTES=60
# 默认仅处理 {1,3,5}，避免用户长时间未编辑的 status=2 被误关闭
UGC_TASK_STALE_STATUSES=1,3,5
# 兼容旧变量（不建议再使用）
UGC_WATCHDOG_TIMEOUT_MINUTES=60

# 自动合成：收到 VIDEO_RESULT 后自动触发 hs004
UGC_AUTO_MERGE_ENABLED=false

# status=4(PENDING_MERGE) 保留时长（分钟），默认 3 天；超时将自动关闭（status=-2, reason=timeout）
UGC_TASK_PENDING_MERGE_TIMEOUT_MINUTES=4320

####################################
# n8n workflow 数据库连接（可选）
####################################
N8N_DATABASE_URL=
N8N_DATABASE_SCHEMA=public
N8N_DATABASE_POOL_SIZE=5
N8N_DATABASE_POOL_MAX_OVERFLOW=5
N8N_DATABASE_POOL_TIMEOUT=30
N8N_DATABASE_POOL_RECYCLE=3600

####################################
# External Admin OAuth2（Client Credentials）
####################################
EXTERNAL_ADMIN_CLIENT_ID=external-admin
EXTERNAL_ADMIN_CLIENT_SECRET=
EXTERNAL_ADMIN_CLIENT_SECRET_ROLLOVER=
EXTERNAL_ADMIN_TOKEN_TTL_SECONDS=900
EXTERNAL_ADMIN_RATE_LIMIT_PER_MIN=60

# 留空表示禁用 IP 限制（启用时为逗号分隔列表）
EXTERNAL_ADMIN_IP_WHITELIST=

# 发放 token 时返回的 scopes（按租户调整，空格分隔）
EXTERNAL_ADMIN_ALLOWED_SCOPES=customers:read customers:write

# 临时跳过外部管理平台鉴权（谨慎使用）
EXTERNAL_ADMIN_AUTH_BYPASS=true

####################################
# 存储配置
####################################
# STORAGE_PROVIDER: "local" | "s3" | "gcs" | "azure"
STORAGE_PROVIDER=local
UPLOAD_DIR=./uploads

####################################
# S3 配置
####################################
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
# S3_REGION_NAME：可选
S3_REGION_NAME=
S3_BUCKET_NAME=
S3_ENDPOINT_URL=
# 可选：对象 key 前缀（例如 <company>/<user>/<hash-name>）
S3_KEY_PREFIX=
S3_USE_ACCELERATE_ENDPOINT=False
# S3_ADDRESSING_STYLE：virtual|path|auto
S3_ADDRESSING_STYLE=virtual
S3_ENABLE_TAGGING=False

####################################
# Google Cloud Storage (GCS) 配置
####################################
GCS_BUCKET_NAME=
GOOGLE_APPLICATION_CREDENTIALS_JSON=

####################################
# Azure Blob Storage 配置
####################################
AZURE_STORAGE_ENDPOINT=
AZURE_STORAGE_CONTAINER_NAME=
AZURE_STORAGE_KEY=

####################################
# PostgreSQL 连接（可选，单独拆分参数）
####################################
POSTGRES_HOST=
POSTGRES_PORT=5432
POSTGRES_DB=
POSTGRES_USER=
POSTGRES_PASSWORD=
# POSTGRES_SSLMODE=require

####################################
# HSAI 素材缓存 / OSS 回填
####################################
HSAI_MATERIALS_CACHE_ENABLED=true
HSAI_MATERIALS_CACHE_TTL_SEC=900
HSAI_MATERIALS_CACHE_REFRESH_INTERVAL_SEC=300

# 避免 SMEMBERS 载荷过大：scheduler 使用 SSCAN，count 范围 1-1000
HSAI_MATERIALS_CACHE_ACTIVE_COMPANIES_SCAN_COUNT=200
# 每次刷新周期最多处理的公司数（0 表示不限制）
HSAI_MATERIALS_CACHE_MAX_COMPANIES_PER_REFRESH=200

# 启用缓存失效后的 OSS→DB 回填（依赖 ffmpeg-go /oss/* 可用）
HSAI_MATERIALS_OSS_SYNC_ENABLED=true
HSAI_MATERIALS_OSS_MAX_KEYS=1000
# 可选：显式指定 OSS bucket（为空则使用 ffmpeg-go 默认配置）
HSAI_MATERIALS_OSS_BUCKET=aima-hotvideogeneration-mp4tots

# ffmpeg-go OSS 服务（列举/下载签名/上传等）
USE_FFMPEG_OSS=true
# 是否通过 ffmpeg-go /oss/download-url 生成签名链接：true=签名；false=直接返回公网直链（要求 OSS 公网可读）
FFMPEG_OSS_SIGNED_URL_ENABLED=true
FFMPEG_API_BASE_URL=http://192.168.20.32:8082
# ffmpeg-go API 前缀（当前实现默认挂载在 /api/v1 下）
FFMPEG_OSS_API_PREFIX=/api/v1
FFMPEG_API_TIMEOUT=30

####################################
# Redis 客户端超时（秒）：影响素材缓存调度器 & Redis 队列监听器
####################################
REDIS_SOCKET_TIMEOUT_SECONDS=5
REDIS_SOCKET_CONNECT_TIMEOUT_SECONDS=5
REDIS_HEALTH_CHECK_INTERVAL_SECONDS=30
REDIS_RETRY_ON_TIMEOUT=true
