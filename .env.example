# Ollama URL for the backend to connect

# The path '/ollama' will be redirected to the specified backend URL

OLLAMA_BASE_URL='http://localhost:11434'
# 如果前后端分离开发（如前端 5173、后端 8080），可显式指定后端基址
VITE_WEBUI_BASE_URL='http://localhost:8080'
 



OPENAI_API_BASE_URL=''

OPENAI_API_KEY=''



# AUTOMATIC1111_BASE_URL="http://localhost:7860"



# For production, you should only need one host as

# fastapi serves the svelte-kit built frontend and backend from the same host and port.

# To test with CORS locally, you can set something like

# CORS_ALLOW_ORIGIN='http://localhost:5173;http://localhost:8080'

CORS_ALLOW_ORIGIN='*'



# For production you should set this to match the proxy configuration (127.0.0.1)

FORWARDED_ALLOW_IPS='*'



# DO NOT TRACK

SCARF_NO_ANALYTICS=true

DO_NOT_TRACK=true

ANONYMIZED_TELEMETRY=false

####################################
# Ops Dashboard Integration
####################################

OPS_DASHBOARD_ENABLED=false
# 渚嬪锛歨ttp://192.168.20.32:5000
OPS_DASHBOARD_BASE_URL=
OPS_DASHBOARD_API_KEY=
OPS_DASHBOARD_TIMEOUT=5
OPS_DASHBOARD_MAX_RETRY=8
OPS_DASHBOARD_ALLOW_CONTENT=false

####################################
# Database Connections
####################################
# Primary application鏁版嵁搴擄紝榛樿浣跨敤 SQLite锛屽彲鏇挎崲涓?PostgreSQL 杩炴帴涓?
DATABASE_URL=

DATABASE_SCHEMA=public



# Owen Admin锛堜换鍔℃ā鏉?/ 绱犳潗娓呭崟锛夋暟鎹簮锛岄粯璁ゅ鐢ㄤ富搴擄紱鑻ヤ娇鐢ㄧ嫭绔嬪簱璇峰～鍐?
ADMIN_DATABASE_URL=

ADMIN_DATABASE_SCHEMA=public

ADMIN_DATABASE_POOL_SIZE=5

ADMIN_DATABASE_POOL_MAX_OVERFLOW=5

ADMIN_DATABASE_POOL_TIMEOUT=30

ADMIN_DATABASE_POOL_RECYCLE=3600



# n8n workflow 搴擄紙钃濆浘/鑴氭湰锛?
N8N_DATABASE_URL=

N8N_DATABASE_SCHEMA=public

N8N_DATABASE_POOL_SIZE=5

N8N_DATABASE_POOL_MAX_OVERFLOW=5

N8N_DATABASE_POOL_TIMEOUT=30

N8N_DATABASE_POOL_RECYCLE=3600



####################################

# External Admin OAuth2 (Client Credentials)

####################################

EXTERNAL_ADMIN_CLIENT_ID=external-admin

EXTERNAL_ADMIN_CLIENT_SECRET=

EXTERNAL_ADMIN_CLIENT_SECRET_ROLLOVER=

EXTERNAL_ADMIN_TOKEN_TTL_SECONDS=900

EXTERNAL_ADMIN_RATE_LIMIT_PER_MIN=60

# Leave blank to disable IP restrictions (comma separated list when enabled)

EXTERNAL_ADMIN_IP_WHITELIST=

# Space separated scopes returned with issued tokens (update per tenant)

EXTERNAL_ADMIN_ALLOWED_SCOPES=customers:read customers:write

# Set to true to temporarily bypass all external admin auth checks (use with caution)

EXTERNAL_ADMIN_AUTH_BYPASS=true



####################################

# 瀛樺偍閰嶇疆 (Storage Configuration)

####################################



# STORAGE_PROVIDER: 瀛樺偍鎻愪緵鑰呯被?

# 鍙€? "local" (鏈湴瀛樺偍), "s3" (S3鍏煎瀛樺偍锛屽闃块噷浜慜SS), "gcs" (Google Cloud Storage), "azure" (Azure Blob Storage)

# 榛樿? "local"

STORAGE_PROVIDER=local

# 夭洗没司一目录 `<company>/<user>/<hash-name>`谢为 s3 目录峁刮?OSS 前缀



# UPLOAD_DIR: 鏈湴瀛樺偍鐩綍璺緞

# 褰揝TORAGE_PROVIDER?local"鏃朵娇鐢ㄦ閰嶇疆

# 榛樿? "./uploads"

UPLOAD_DIR=./uploads



####################################

# 闃块噷浜慜SS (S3鍏煎) 閰嶇疆

####################################



# S3_ACCESS_KEY_ID: 闃块噷浜戣闂瘑閽D

# 鐢ㄤ簬韬唤楠岃瘉鐨勮闂瘑閽D锛屽彲鍦ㄩ樋閲屼簯鎺у埗鍙拌幏?

S3_ACCESS_KEY_ID=



# S3_SECRET_ACCESS_KEY: 闃块噷浜戣闂瘑?

# 涓庤闂瘑閽D閰嶅浣跨敤鐨勫瘑閽ワ紝鐢ㄤ簬韬唤楠岃瘉

S3_SECRET_ACCESS_KEY=



# S3_REGION_NAME: 闃块噷浜慜SS鍖哄煙鍚嶇О

# 鎸囧畾OSS瀛樺偍妗舵墍鍦ㄧ殑鍖哄煙锛屽"oss-cn-hangzhou"

S3_REGION_NAME=



# S3_BUCKET_NAME: 闃块噷浜慜SS瀛樺偍妗跺悕?

# 鎸囧畾瑕佷娇鐢ㄧ殑OSS瀛樺偍妗跺悕?

S3_BUCKET_NAME=



# S3_ENDPOINT_URL: 闃块噷浜慜SS鏈嶅姟绔偣URL

# 鎸囧畾OSS鏈嶅姟鐨勮闂鐐癸紝鏍煎紡?https://oss-{region}.aliyuncs.com"

S3_ENDPOINT_URL=



# S3_KEY_PREFIX: OSS瀵硅薄閿墠缂€

# 鐢ㄤ簬鍦ㄥ瓨鍌ㄦ《涓粍缁囨枃浠剁殑鍓嶇紑锛岀被浼间簬鏂囦欢澶硅矾?

S3_KEY_PREFIX=



# S3_USE_ACCELERATE_ENDPOINT: 鏄惁浣跨敤浼犺緭鍔犻€熺?

# 鍚敤鍚庡彲鎻愰珮璺ㄥ湴鍩熶紶杈撴€ц兘锛屼絾鍙兘浼氫骇鐢熼澶栬垂?

# 鍙€? True/False

# 榛樿? False

S3_USE_ACCELERATE_ENDPOINT=False



# S3_ADDRESSING_STYLE: S3瀵诲潃椋庢牸

# 鍙€? "virtual" (铏氭嫙瀵诲潃), "path" (璺緞瀵诲潃)

# 铏氭嫙瀵诲潃鏄帹鑽愭柟寮忥紝浣嗘煇浜涙棫鐗堟湰瀹㈡埛绔彲鑳介渶瑕佷娇鐢ㄨ矾寰勫鍧€

S3_ADDRESSING_STYLE=virtual



# S3_ENABLE_TAGGING: 鏄惁鍚敤瀵硅薄鏍囩

# 鍚敤鍚庡彲涓轰笂浼犵殑鏂囦欢娣诲姞鏍囩锛屼究浜庣鐞嗗拰妫€?

# 鍙€? True/False

# 榛樿? False

S3_ENABLE_TAGGING=False



####################################

# Google Cloud Storage 閰嶇疆

####################################



# GCS_BUCKET_NAME: Google Cloud Storage瀛樺偍妗跺悕?

GCS_BUCKET_NAME=



# GOOGLE_APPLICATION_CREDENTIALS_JSON: Google鏈嶅姟璐︽埛鍑瘉JSON

GOOGLE_APPLICATION_CREDENTIALS_JSON=



####################################

# Azure Blob Storage 閰嶇疆

####################################



# AZURE_STORAGE_ENDPOINT: Azure瀛樺偍璐︽埛绔偣

AZURE_STORAGE_ENDPOINT=



# AZURE_STORAGE_CONTAINER_NAME: Azure瀛樺偍瀹瑰櫒鍚嶇О

AZURE_STORAGE_CONTAINER_NAME=



# AZURE_STORAGE_KEY: Azure瀛樺偍璐︽埛瀵嗛挜

AZURE_STORAGE_KEY=

####################################

# PostgreSQL 鍚屾鑴氭湰鍙傛暟 (sqlite_to_postgres_sync.py)

####################################



# PostgreSQL 杩炴帴淇℃伅

POSTGRES_HOST=

POSTGRES_PORT=5432

POSTGRES_DB=

POSTGRES_USER=

POSTGRES_PASSWORD=

# POSTGRES_SSLMODE=require

####################################
# HSAI 素材缓存 / OSS 回填
####################################

# 是否启用素材 Redis 缓存（目录树 + 列表快照）
HSAI_MATERIALS_CACHE_ENABLED=true
# 缓存 TTL（秒）
HSAI_MATERIALS_CACHE_TTL_SEC=900
# 定时刷新间隔（秒）
HSAI_MATERIALS_CACHE_REFRESH_INTERVAL_SEC=300

# 是否启用缓存失效后的 OSS→DB 回填（依赖 ffmpeg-go /oss/* 可用）
HSAI_MATERIALS_OSS_SYNC_ENABLED=true
# 单次列举最大对象数（1-1000）
HSAI_MATERIALS_OSS_MAX_KEYS=1000
# 可选：显式指定 OSS Bucket（为空则使用 ffmpeg-go 默认配置）
HSAI_MATERIALS_OSS_BUCKET=

# ffmpeg-go OSS 中台（用于列举/下载签名/上传等）
USE_FFMPEG_OSS=true
FFMPEG_API_BASE_URL=http://127.0.0.1:8082
# 建议填写裸 token，服务端会自动补齐 Bearer；如已包含 Bearer 前缀也可直接填写完整值
FFMPEG_API_KEY=
FFMPEG_API_TIMEOUT=30


